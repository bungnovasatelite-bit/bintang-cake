# =============================================================================
# Bintang Cake & Cookies - Environment Variables Example
# =============================================================================
# Salin file ini menjadi .env lalu isi dengan kredensial project Supabase Anda.
# 
# PENTING / KEAMANAN:
# - HANYA gunakan Publishable / Anon Key (VITE_SUPABASE_ANON_KEY).
# - JANGAN PERNAH memasukkan secret key seperti 'service_role' ke dalam file ini
#   atau ke kode frontend karena kunci tersebut memiliki bypass RLS (Row Level Security)
#   dan dapat diekspos ke publik melalui bundle JavaScript browser.
# =============================================================================

# URL Project Supabase (contoh: https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (Publishable) Public Key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
